# VPS only: 32 to 256 visible ASCII characters, no spaces. Example: openssl rand -hex 32
# Save it to /etc/lain/model.env. Do not use the placeholder below.
MODEL_API_TOKEN=replace-with-a-random-secret

# Vercel project environment variables (configure in Vercel, never in the browser):
# MODEL_API_URL=https://api.example.com
# MODEL_API_TOKEN=<same-secret-as-on-vps>
