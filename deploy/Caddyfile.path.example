# Add inside an existing HTTPS site block before its catch-all reverse_proxy.
# The model container must share a Docker network with Caddy and publish no host port.
# Only the generation and health routes are forwarded.
handle /lain/api/generate {
    request_body {
        max_size 8KB
    }
    uri strip_prefix /lain
    reverse_proxy lain-model:8080 {
        header_up -Forwarded
    }
}
handle /lain/health {
    uri strip_prefix /lain
    reverse_proxy lain-model:8080 {
        header_up -Forwarded
    }
}
